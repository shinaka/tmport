# User's original game files and anything derived from them stay local.
/TM-DOS/
/TM-WIN/
/extracted/
# Ghidra projects and decompiler output are derived from the original binary.
/re/ghidra_proj/
/re/*/ghidra_export/
/re/*/ghidra_headless*.log
# Third-party tools downloaded locally.
/tools/dl/
/tools/ghidra/
/tools/dosbox-x/
__pycache__/
# Build output.
/build*/
/out/
.vs/
/dist/
